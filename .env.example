# Copy to .env and fill in. Never commit .env — see .gitignore.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Keep all three databases in the SAME region as the app. A send makes three
# sequential round trips; split across regions that is ~250ms of pure network per
# message, co-located it is single-digit milliseconds.

# --- Postgres (Neon free tier) ---
# Relational + transactional: users, conversations, memberships, read state.
#
# Use the DIRECT endpoint, not the "-pooler" one. Measured here, the pooled
# endpoint cost ~325ms extra per query. A pooler is for serverless runtimes that
# open a connection per invocation; this app has long-lived processes and Prisma
# already pools internally.
DATABASE_URL=postgresql://user:password@host.neon.tech/relay?sslmode=require

# The same direct URL. Prisma uses it for migrations, which take advisory locks
# and run DDL — neither survives a transaction-mode pooler.
DIRECT_URL=postgresql://user:password@host.neon.tech/relay?sslmode=require

# --- MongoDB (Atlas M0 free tier) ---
# Append-only message log.
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/relay?retryWrites=true&w=majority

# --- Redis (Redis Cloud Essentials free tier) ---
# socket.io pub/sub adapter + presence leases + rate limiting.
# NOTE: must be a TCP endpoint. Upstash's HTTP/REST API does NOT support pub/sub,
# which the socket.io adapter requires.
REDIS_URL=redis://default:password@host.redns.redis-cloud.com:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-at-least-32-characters-of-random-hex
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# 12 is ~250ms on normal hardware; drop to 10 on a 0.1-vCPU free tier if login feels slow.
BCRYPT_ROUNDS=12
